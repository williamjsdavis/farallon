# Set this locally; it is read only by the Python server.
OPENAI_API_KEY=
# Defaults for scripts/API requests that omit model_preset.
# The UI's four fixed presets select their own model, reasoning and Fast tier.
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=low
# Fast mode has premium token pricing. Use default for Standard, auto for project settings.
OPENAI_SERVICE_TIER=fast
